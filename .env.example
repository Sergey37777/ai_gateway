# Настройки ai_gateway (префикс AIGW_). Скопируйте в .env и поправьте при необходимости.

# auto / cuda / cpu
AIGW_DEVICE=auto
# auto (float16 на GPU, int8 на CPU) / float16 / int8_float16 / int8 / ...
AIGW_COMPUTE_TYPE=auto
# если задан — требуется заголовок Authorization: Bearer <ключ>
# AIGW_API_KEY=change-me
# лимит размера загружаемого файла, МБ
AIGW_MAX_UPLOAD_MB=200
# реестр моделей
AIGW_MODELS_FILE=models.yaml
# TTL простоя модели по умолчанию, сек (-1 — не выгружать, 0 — сразу после запроса)
AIGW_DEFAULT_TTL=600
# период проверки простоя, сек
AIGW_SWEEP_INTERVAL=30
# уровень логов: DEBUG / INFO / WARNING / ERROR
AIGW_LOG_LEVEL=INFO
# адрес Ollama; в docker compose задаётся сам (http://ollama:11434), по умолчанию http://localhost:11434
# AIGW_OLLAMA_URL=http://localhost:11434
# макс. пауза между байтами ответа Ollama, сек
AIGW_OLLAMA_READ_TIMEOUT=300

# Настройки контейнера ollama (подставляются в docker-compose.yml)
# простой до выгрузки модели из VRAM
OLLAMA_KEEP_ALIVE=10m
# параллельных запросов на модель (каждый слот умножает KV-кэш)
OLLAMA_NUM_PARALLEL=1
# длина контекста (агентам нужен длинный)
OLLAMA_CONTEXT_LENGTH=16384
# flash attention (нужен для квантования KV-кэша)
OLLAMA_FLASH_ATTENTION=1
# KV-кэш вдвое меньше f16
OLLAMA_KV_CACHE_TYPE=q8_0

# часовой пояс контейнера для времени в логах (без него — UTC)
TZ=Europe/Moscow
