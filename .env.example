# Настройки ai_gateway (префикс AIGW_). Скопируйте в .env и поправьте при необходимости.

# auto / cuda / cpu
AIGW_DEVICE=auto
# auto (float16 на GPU, int8 на CPU) / float16 / int8_float16 / int8 / ...
AIGW_COMPUTE_TYPE=auto
# если задан — требуется заголовок Authorization: Bearer <ключ>
# AIGW_API_KEY=change-me
# лимит размера загружаемого файла, МБ
AIGW_MAX_UPLOAD_MB=200
# реестр моделей
AIGW_MODELS_FILE=models.yaml
# TTL простоя модели по умолчанию, сек (-1 — не выгружать, 0 — сразу после запроса)
AIGW_DEFAULT_TTL=600
# период проверки простоя, сек
AIGW_SWEEP_INTERVAL=30
# уровень логов: DEBUG / INFO / WARNING / ERROR
AIGW_LOG_LEVEL=INFO
# адрес Ollama; в docker compose задаётся сам (http://host.docker.internal:11434 — нативная Ollama
# на Windows-хосте), по умолчанию http://localhost:11434
# AIGW_OLLAMA_URL=http://localhost:11434
# макс. пауза между байтами ответа Ollama, сек
AIGW_OLLAMA_READ_TIMEOUT=300

# Ollama запускается нативно на Windows и этот файл НЕ читает. Рекомендуемые настройки задаются
# переменными среды пользователя Windows (после изменения — перезапустить Ollama из трея):
#   OLLAMA_KEEP_ALIVE=10m        простой до выгрузки модели из VRAM
#   OLLAMA_NUM_PARALLEL=1        параллельных запросов на модель (каждый слот умножает KV-кэш)
#   OLLAMA_CONTEXT_LENGTH=16384  длина контекста (агентам нужен длинный)
#   OLLAMA_FLASH_ATTENTION=1     flash attention (нужен для квантования KV-кэша)
#   OLLAMA_KV_CACHE_TYPE=q8_0    KV-кэш вдвое меньше f16

# каталог собранного Web UI (в Docker-образе — /app/web); нет каталога — UI не раздаётся
# AIGW_WEB_DIR=web/dist

# часовой пояс контейнера для времени в логах (без него — UTC)
TZ=Europe/Moscow

# пароль PostgreSQL в docker compose (подставляется и в AIGW_DATABASE_URL шлюза)
POSTGRES_PASSWORD=aigw

# PostgreSQL: история распознаваний и очередь задач.
# В docker compose задаётся сам; для разработки — compose.dev.yaml (127.0.0.1:55432)
# AIGW_DATABASE_URL=postgresql+psycopg://aigw:aigw@localhost:55432/aigw
# каталог загрузок и Opus-аудио истории (в Docker — volume /data)
# AIGW_DATA_DIR=data
